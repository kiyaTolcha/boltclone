{
  "manifest_version": 3,
  "name": "BOLTCLONE",
  "version": "1.0.0",
  "description": "APIsec BOLT clone for traffic capture, analysis, and OpenAPI generation.",
  "permissions": ["storage", "tabs", "webRequest", "activeTab", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "BOLTCLONE" },
  "devtools_page": "devtools.html",
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"] }
  ],
  "web_accessible_resources": [
    { "resources": ["devtools.html", "panel.html"], "matches": ["<all_urls>"] }
  ]
}
